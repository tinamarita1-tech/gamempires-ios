<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Drop shadow behind the Crowned Shield -->
    <path
        android:pathData="M32,38 H76 C76,38 76,58 76,61 C76,73 54,83 54,83 C54,83 32,73 32,61 Z"
        android:fillColor="#4D000000" />

    <!-- 2. Crowned Shield base body (Obsidian Dark with Gold rim) -->
    <path
        android:pathData="M32,37 H76 C76,37 76,57 76,60 C76,72 54,82 54,82 C54,82 32,72 32,60 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#FFAB00">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="37"
                android:endX="54"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#222836" />
                <item android:offset="0.5" android:color="#141822" />
                <item android:offset="1.0" android:color="#0C0E14" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Gold 3-Point Crown resting on top of Shield -->
    <path
        android:pathData="M41,36 L41,27 L47,31 L54,23 L61,31 L67,27 L67,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="23"
                android:endX="54"
                android:endY="36"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE082" />
                <item android:offset="0.5" android:color="#FFB300" />
                <item android:offset="1.0" android:color="#E65100" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crown bottom band rim highlight -->
    <path
        android:pathData="M41,35 H67 V37 H41 Z"
        android:fillColor="#FFD54F" />

    <!-- Crown 3 jewel points -->
    <path
        android:pathData="M41,27 A1.2,1.2 0 1 0 41,24.6 A1.2,1.2 0 1 0 41,27 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M54,23 A1.5,1.5 0 1 0 54,20 A1.5,1.5 0 1 0 54,23 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M67,27 A1.2,1.2 0 1 0 67,24.6 A1.2,1.2 0 1 0 67,27 Z"
        android:fillColor="#FFFFFF" />

    <!-- 4. Split Geometric White "G" & "E" Monogram inside Shield -->
    <!-- "G" Monogram -->
    <path
        android:pathData="M49,46 H38 V70 H49 V58 H43.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />

    <!-- "E" Monogram -->
    <path
        android:pathData="M70,46 H59 V70 H70 M59,58 H68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />

    <!-- 5. Diagonal Specular Gloss Sheen across top-left of Shield -->
    <path
        android:pathData="M32,37 H64 L32,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="37"
                android:endX="64"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#40FFFFFF" />
                <item android:offset="0.5" android:color="#18FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
