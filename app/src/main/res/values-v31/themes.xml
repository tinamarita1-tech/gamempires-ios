<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system launch screen uses these instead of windowBackground. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:navigationBarColor">#141414</item>
        <item name="android:windowSplashScreenBackground">@color/charcoal_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/charcoal_bg</item>
    </style>
</resources>
